---
import AuthLayout from "@layouts/AuthLayout.astro";

const email = Astro.cookies.get("email")?.value || "";
const rememberMe = !!email;

export const prerender = false;
---

<AuthLayout>
    <div class="mb-4">
        <h3 class="font-semibold text-2xl text-gray-800">Login</h3>
        <p class="text-gray-500">Please sign in to your account.</p>
    </div>
    <form class="space-y-5">
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700 tracking-wide"
                >Email</label
            >
            <input
                class="w-full text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
                type="email"
                placeholder="mail@gmail.com"
                name="email"
                value={email}
            />
        </div>
        <div class="space-y-2">
            <label class="mb-5 text-sm font-medium text-gray-700 tracking-wide">
                Password
            </label>
            <input
                class="w-full content-center text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
                type="password"
                placeholder="Enter your password"
                name="password"
            />
        </div>
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <input
                    id="remember_me"
                    name="remember_me"
                    type="checkbox"
                    class="h-4 w-4 bg-blue-500 focus:ring-blue-400 border-gray-300 rounded"
                    checked={rememberMe}
                />
                <label
                    for="remember_me"
                    class="ml-2 block text-sm text-gray-800"
                >
                    Recuerdame
                </label>
            </div>
            <div class="text-sm">
                <a href="/register" class="text-green-400 hover:text-green-500">
                    ¿No tienes cuenta?
                </a>
            </div>
        </div>
        <div>
            <button
                id="login"
                type="submit"
                class="disabled:bg-gray-300 w-full flex justify-center bg-green-400 hover:bg-green-500 text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-500"
            >
                Ingresar
            </button>

            <div class="flex flex-1 w-full my-3">
                <div class="w-full border-t-2 border-gray-500">                    
                </div>
            </div>

            <button
                id="login-google"
                type="button"
                class="disabled:bg-gray-300 w-full flex justify-center bg-red-400 hover:bg-red-500 text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-500"
            >
                Ingresar con Google
            </button>
        </div>
    </form>
    <div class="pt-5 text-center text-gray-400 text-xs">
        <span>
            Copyright © 2021- { new Date().getFullYear() }
            <a
                href="https://codepen.io/uidesignhub"
                rel=""
                target="_blank"
                title="Ajimon"
                class="text-green hover:text-green-500">AJI</a
            ></span
        >
    </div>
</AuthLayout>

<script>
    import { actions } from "astro:actions";
    import { GoogleAuthProvider, signInWithPopup } from 'firebase/auth';
    import { firebase } from "src/firebase/config";
    import Swal from 'sweetalert2';

    const form = document.querySelector("form") as HTMLFormElement;
    const loginForm = document.getElementById('login') as HTMLButtonElement;
    const btnGoogle = document.getElementById('login-google') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        loginForm.disabled = true; 

        const formData = new FormData(form);

        const { data, error } = await actions.loginUser(formData);

        if ( error ) {
            Swal.fire({
                icon: 'error',
                title: 'Credenciales no son correctas',
                text: error.message
            })
            loginForm.disabled = false;
            return;
        }

        window.location.replace('/protected')

        loginForm?.setAttribute('disabled', 'false');
    })

    btnGoogle?.addEventListener('click', async () => {
        btnGoogle.disabled = true;

        // Paso 1: obtener la credencial del usuario a través de un popup de Google.
        const provider = new GoogleAuthProvider();

        // Paso 2: usar la credencial para autenticar al usuario en Firebase.
        
        try {
            const credenciales = await signInWithPopup(firebase.auth, provider);
            // console.log(' credenciales: ', credenciales);
            
            const {data, error} = await actions.loginWithGoogle(credenciales);

            if ( error ) {
                alert(error.message);
                btnGoogle.disabled = false;
                return;
            }   

            btnGoogle.innerText = 'Redirigiendo...';
            window.location.replace('/protected');




        } catch (error) {
            console.log(error);
            
        }

        btnGoogle.disabled = false;
    })
</script>

